#!/usr/bin/env python3
import json
import os
import subprocess
import shutil
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
STATE = ROOT / ".superplatform" / "state"
REPORTS = ROOT / ".superplatform" / "reports"
STATE.mkdir(parents=True, exist_ok=True)
REPORTS.mkdir(parents=True, exist_ok=True)

REPORT = {
    "project": "SuperPlatform",
    "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "stages": [],
    "status": "RUNNING",
}

def run(name, cmd, timeout=900):
    print(f"\n{'='*70}\n[{name}]\n{'='*70}")
    try:
        p = subprocess.run(
            cmd,
            cwd=ROOT,
            shell=True,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
        output = p.stdout[-30000:]
        print(output)
        no_tests = (
            p.returncode == 0
            and (
                "NO TESTS RAN" in output
                or "Ran 0 tests" in output
                or "collected 0 items" in output
            )
        )

        result = {
            "name": name,
            "returncode": p.returncode,
            "passed": p.returncode == 0 and not no_tests,
            "no_tests_discovered": no_tests,
            "output": output,
        }
    except subprocess.TimeoutExpired as e:
        output = (e.stdout or "")[-30000:] if e.stdout else ""
        result = {
            "name": name,
            "returncode": 124,
            "passed": False,
            "output": output + "\nTIMEOUT",
        }
        print(output)
        print("TIMEOUT")
    except Exception as e:
        result = {
            "name": name,
            "returncode": 1,
            "passed": False,
            "output": str(e),
        }
        print("ERROR:", e)

    REPORT["stages"].append(result)
    return result["passed"]

def save_report(status=None):
    if status:
        REPORT["status"] = status
    REPORT["finished_at"] = time.strftime(
        "%Y-%m-%dT%H:%M:%SZ", time.gmtime()
    )
    path = REPORTS / "master_report.json"
    path.write_text(
        json.dumps(REPORT, indent=2, ensure_ascii=False),
        encoding="utf-8",
    )
    return path

print("""
╔══════════════════════════════════════════════════════════════╗
║          SUPERPLATFORM MASTER AUTOMATION ENGINE             ║
║       AUDIT → TEST → DIAGNOSE → REPAIR → VERIFY             ║
╚══════════════════════════════════════════════════════════════╝
""")

# 0. Repository safety checkpoint
if not run(
    "GIT SAFETY CHECK",
    "git rev-parse --is-inside-work-tree && git status --short",
):
    save_report("BLOCKED")
    sys.exit(1)

# 1. Python syntax
if not run(
    "PYTHON SYNTAX",
    "python -m compileall -q .",
):
    print("\nPYTHON SYNTAX FAILED.")
    print("No automatic destructive repair will be attempted.")
    save_report("FAILED_SYNTAX")
    sys.exit(2)

# 2. Universal test discovery and execution
print("\\nTEST DISCOVERY")

test_results = []
test_candidates = []

if shutil.which("pytest"):
    test_candidates.append(("PYTEST", "pytest -q"))

if (
    (ROOT / "pytest.ini").exists()
    or (ROOT / "pyproject.toml").exists()
    or (ROOT / "setup.cfg").exists()
    or (ROOT / "tests").exists()
):
    if shutil.which("pytest") and ("PYTEST", "pytest -q") not in test_candidates:
        test_candidates.append(("PYTEST", "pytest -q"))

test_candidates.append(("UNITTEST", "python -m unittest discover -v"))

for name, cmd in test_candidates:
    r = run("PROJECT TEST: " + name, cmd, timeout=1800)
    test_results.append({
        "name": name,
        "passed": r,
    })

# Existing SuperPlatform self-healing regression tests
self_heal_tests = [
    ROOT / ".self-healing/tests/test_pydantic_core_android.sh",
    ROOT / ".self-healing/tests/test_android_pydantic_workflow_integrity.sh",
]

for test in self_heal_tests:
    if test.exists():
        test.chmod(test.stat().st_mode | 0o111)
        run(
            "SELF-HEALING REGRESSION: " + str(test.relative_to(ROOT)),
            f"bash {test}",
            timeout=1800,
        )

if not test_candidates and not any(x.exists() for x in self_heal_tests):
    print("NO TEST FRAMEWORK OR REGISTERED TESTS DISCOVERED")

# 3. GitHub workflow inventory
run(
    "WORKFLOW AUDIT",
    "find .github/workflows -maxdepth 1 -type f -print 2>/dev/null || true",
)

# 4. Dependency metadata audit
run(
    "DEPENDENCY INVENTORY",
    "find . -maxdepth 3 -type f "
    "\\( -name 'requirements*.txt' -o -name 'pyproject.toml' "
    "-o -name 'package.json' -o -name 'go.mod' -o -name 'Cargo.toml' \\) "
    "-print",
)

# 5. Existing self-healing engine, if present
healer = ROOT / ".self-healing" / "engine" / "self_heal_orchestrator.sh"

if healer.exists() and os.access(healer, os.X_OK):
    print("\nSELF-HEALING ENGINE DETECTED.")
    print("SAFE MODE: existing engine may diagnose/validate.")
    run(
        "SELF-HEALING VALIDATION",
        f"bash {healer} --help 2>/dev/null || true",
        timeout=120,
    )
else:
    print("\nNo executable self-healing orchestrator detected.")

# 6. Final evidence
report_path = save_report()

failed = [
    x for x in REPORT["stages"]
    if not x["passed"] and not x.get("no_tests_discovered", False)
]

no_tests = [
    x for x in REPORT["stages"]
    if x.get("no_tests_discovered", False)
]

if failed:
    REPORT["status"] = "FAILED_WITH_EVIDENCE"
else:
    executed = [
        x for x in REPORT["stages"]
        if x.get("name", "").startswith("PROJECT TEST")
        or x.get("name", "").startswith("SELF-HEALING REGRESSION")
    ]

    passed_tests = [x for x in executed if x.get("passed")]

    if executed and passed_tests:
        if no_tests:
            REPORT["status"] = "PARTIALLY_VERIFIED_TEST_EVIDENCE"
        else:
            REPORT["status"] = "VERIFIED_LOCAL_CHECKS"
    else:
        REPORT["status"] = "NO_EXECUTED_TEST_EVIDENCE"

report_path.write_text(
    json.dumps(REPORT, indent=2, ensure_ascii=False),
    encoding="utf-8",
)

print("\n" + "="*70)
print("SUPERPLATFORM MASTER RESULT")
print("="*70)
print("STATUS :", REPORT["status"])
print("REPORT :", report_path)
print("FAILED :", len(failed))

if failed:
    print("\nIMPORTANT:")
    print("Failure detected. No false PASS and no automatic production deployment.")
    sys.exit(3)

print("\nLOCAL VERIFICATION COMPLETE.")
print("Production deployment is NOT claimed.")
